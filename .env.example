# OneHealth — Backend. Copiare in `.env` e inserire le proprie chiavi (il file `.env` non va mai committato).
# Si usa con:  uv run --env-file .env <script>

# OpenAQ (aria): chiave gratuita dall'account su https://explore.openaq.org/register
OPENAQ_API_KEY=

# Copernicus (CAMS dall'ADS e ERA5-Land dal CDS): chiave gratuita dal profilo dell'account Copernicus.
# Vanno accettate a mano, sul sito, le licenze dei dataset usati.
COPERNICUS_API_KEY=

# Facoltative: i valori di default sono quelli indicati.
# ONEHEALTH_HOST=127.0.0.1                                       # indirizzo del server FastAPI
# ONEHEALTH_PORT=8000                                            # porta del server FastAPI
# ONEHEALTH_ORIGINI=http://127.0.0.1:5173,http://localhost:5173  # origini del Frontend ammesse (CORS)
# ONEHEALTH_LLM=qwen3.5:4b                                       # modello di ONE, in Ollama
# OLLAMA_HOST=127.0.0.1:11434                                    # dove risponde Ollama
